<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Non-sandboxed Developer/self-signed distribution: a general-purpose disk cleaner
         needs access outside an app-sandbox container. Do NOT add com.apple.security.app-sandbox. -->

    <!-- WebView (WKWebView/JavaScriptCore) requires JIT under a hardened runtime sign.
         Tauri does not auto-inject these; harmless under ad-hoc/self-signed. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Network access for the GitHub updater check. -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
