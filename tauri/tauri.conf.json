{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "null-e",
  "version": "0.4.0",
  "identifier": "com.null-e.disk-cleaner",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../ui && bun run dev",
    "beforeBuildCommand": "cd ../ui && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "null-e - Disk Cleanup Robot",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Disk cleanup tool for developers",
    "longDescription": "Find and remove build artifacts, caches, and unused dependencies to free up disk space.",
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "../Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/us/null-e/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2QzAyMUJEOTRGQUMzRTYKUldUbXcvcVV2U0hBVmh3cnhRTkw4UnY1OHd3QjZqaEMyOUZQOG1Qd3RxUndzTUZ0WFllRFRtSVAK"
    }
  }
}
